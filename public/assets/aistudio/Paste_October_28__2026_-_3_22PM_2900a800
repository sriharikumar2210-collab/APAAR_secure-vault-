  app.use('/api', (_req: Request, res: Response) => {
    res.status(404).json({ error: 'Not found' });
  });

  // ------------------------------------------------------------------
  // Frontend
  // ------------------------------------------------------------------

  if (!isProd) {
    process.env.DISABLE_HMR = 'true';
