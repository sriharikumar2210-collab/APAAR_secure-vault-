          >
            <div className="flex items-start justify-between gap-4">
              <div className="space-y-1 min-w-0">
                <span
                  className={`inline-block text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded border ${
                    isTampered
                      ? 'bg-rose-100 text-rose-700 border-rose-300 dark:bg-rose-950 dark:text-rose-300 dark:border-rose-700'
                      : 'bg-emerald-50 text-emerald-700 border-emerald-200 dark:bg-emerald-950/80 dark:text-emerald-400 dark:border-emerald-800'
                  }`}
                >
                  {isSelfUpload ? 'Student upload · not issuer-signed' : isTampered ? 'Integrity check failed' : 'Integrity check passed'}
                </span>
                <h4 className={`text-base font-bold mt-1 ${strong}`}>{TYPE_LABEL[activeCred.type]}</h4>
                <p className="text-xs text-slate-600 dark:text-slate-300">{activeCred.issuingInstitution}</p>
              </div>
              <div className="w-16 h-16 bg-white border border-slate-200 p-1 rounded-lg shrink-0 flex items-center justify-center">
                <QrCode className="w-14 h-14 text-slate-900" />
              </div>
            </div>

            <div className="grid grid-cols-1 sm:grid-cols-3 gap-3 bg-white dark:bg-slate-950/70 p-4 rounded-lg border border-slate-200 dark:border-slate-800 text-xs">
              <div>
                <span className={`block text-[10px] ${muted}`}>Score / performance</span>
                <strong className={isTampered ? 'text-rose-700 dark:text-rose-400' : 'text-emerald-700 dark:text-emerald-400'}>
                  {isTampered && activeCheck.alteredField ? activeCheck.alteredField.altered : activeCred.cgpaOrPercentage}
                </strong>
              </div>
              <div>
                <span className={`block text-[10px] ${muted}`}>Year</span>
                <strong className={strong}>{activeCred.yearOfPassing}</strong>
              </div>
              <div className="min-w-0">
                <span className={`block text-[10px] ${muted}`}>Credential ID</span>
                <strong className="font-mono text-[11px] text-amber-700 dark:text-amber-400 break-all">{activeCred.id}</strong>
              </div>
            </div>

            <div className="text-[11px] font-mono bg-white dark:bg-slate-950/50 p-2.5 rounded border border-slate-200 dark:border-slate-800/80 break-all">
              <span className={muted}>Record URI: </span>
              <span className="text-slate-800 dark:text-slate-200">{activeCred.digilockerUri}</span>
            </div>
          </div>

          {/* Integrity details */}
          <div className="bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-xl p-4 space-y-2 text-xs font-mono">
            <div className="flex flex-wrap items-center justify-between gap-2 border-b border-slate-200 dark:border-slate-800 pb-2">
              <span className="font-semibold flex items-center gap-1.5 text-slate-800 dark:text-slate-300">
                <Lock className="w-3.5 h-3.5 text-amber-500" />
                Integrity check
              </span>
              <span className={`text-[10px] ${muted}`}>
                Checked: {activeCheck.checkedAt ? formatIst(activeCheck.checkedAt) : '—'}
              </span>
            </div>
            <div className={`space-y-1.5 text-[11px] pt-1 ${muted}`}>
              <div>
                <span>Method: </span>
                <span className="text-slate-800 dark:text-slate-200">{signatureLabel(activeCred)}</span>
              </div>
              <div className="break-all">
                <span>Hash recorded at issue: </span>
                <span className="text-slate-800 dark:text-slate-200">{activeCred.sha256Hash}</span>
              </div>
              <div className="break-all">
                <span>Hash of presented document: </span>
                <span className={isTampered ? 'text-rose-700 dark:text-rose-400 font-bold' : 'text-emerald-700 dark:text-emerald-400'}>
                  {activeCheck.computedHash || '—'}
                </span>
              </div>
            </div>
          </div>

          <div className="flex flex-wrap items-center justify-between gap-2 pt-2 border-t border-slate-200 dark:border-slate-800 text-xs">
            <button
              onClick={() => onViewCertificateDetails(activeCred)}
              className="flex items-center gap-1.5 px-3 py-2 bg-white dark:bg-slate-800 hover:bg-slate-100 dark:hover:bg-slate-700 text-slate-800 dark:text-slate-100 font-semibold rounded-lg border border-slate-300 dark:border-slate-700"
            >
              <Eye className="w-3.5 h-3.5 text-amber-500" />
              <span>View certificate</span>
            </button>
            <button
              onClick={() => window.print()}
              className="flex items-center gap-1.5 px-3 py-2 bg-white dark:bg-slate-800 hover:bg-slate-100 dark:hover:bg-slate-700 text-slate-800 dark:text-slate-100 font-semibold rounded-lg border border-slate-300 dark:border-slate-700"
            >
              <Download className="w-3.5 h-3.5 text-amber-500" />
              <span>Print / save as PDF</span>
            </button>
          </div>
        </div>
      </div>

      {isSealOpen && onSealCredential && (
        <VaultDocumentForm
          mode="ISSUE"
          studentName={student.name}
          onClose={() => setIsSealOpen(false)}
          onSubmit={async values => {
            const problem = await onSealCredential(student.apaarId, values);
            if (!problem) setSealNotice(`Issued and signed "${values.credential.title}" for ${student.name}.`);
            return problem;
          }}
        />
      )}
    </div>
  );
};

