    URL.revokeObjectURL(url);
  };

  const copyHash = async (log: AuditLogEntry) => {
    try {
      await navigator.clipboard.writeText(log.sha256Fingerprint);
      setCopiedId(log.id);
      setTimeout(() => setCopiedId(null), 1500);
    } catch {
      /* clipboard not available */
    }
  };

  const selectCls =
    'w-full bg-white dark:bg-[#111927] border border-slate-300 dark:border-slate-800 rounded-lg px-3 py-2 text-slate-900 dark:text-white focus:outline-none focus:border-amber-500 cursor-pointer';

