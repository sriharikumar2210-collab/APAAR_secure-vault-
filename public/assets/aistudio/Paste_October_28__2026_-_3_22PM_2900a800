              )}
            </div>
          )}

          {/* Document card */}
          <div
            className={`rounded-xl p-6 border space-y-4 ${
              isTampered
                ? 'bg-rose-50/60 border-rose-300 dark:bg-rose-950/20 dark:border-rose-800'
