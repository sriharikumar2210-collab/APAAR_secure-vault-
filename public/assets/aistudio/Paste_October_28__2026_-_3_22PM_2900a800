/**
 * @license
 * SPDX-License-Identifier: Apache-2.0
 *
 * Server-side validation for PDF files added to the APAAR Secure Vault.
 * The browser runs the same rules first (src/utils/vaultRules.ts), but only this check counts.
 */

import crypto from 'crypto';
import { pdfProblem } from '../utils/vaultRules.ts';

export { MIN_PDF_BYTES, MAX_PDF_BYTES } from '../utils/vaultRules.ts';

export type PdfCheck =
  | { ok: true; size: number; sha256: string; fileName: string }
  | { ok: false; error: string };

const SAFE_NAME = /[^A-Za-z0-9._ -]+/g;

/** Checks a base64-encoded upload: real PDF header and trailer, size limits, safe file name. */
export function checkPdfUpload(base64: unknown, rawName: unknown): PdfCheck {
  if (typeof base64 !== 'string' || base64.length === 0) {
    return { ok: false, error: 'Attach the document as a PDF file.' };
  }
  const cleaned = base64.replace(/^data:[^;]+;base64,/, '');
  if (!/^[A-Za-z0-9+/=\s]+$/.test(cleaned)) return { ok: false, error: 'The file could not be read.' };
  const bytes = Buffer.from(cleaned, 'base64');
  const problem = pdfProblem(bytes);
  if (problem) return { ok: false, error: problem };
  let fileName = typeof rawName === 'string' && rawName.trim() ? rawName.replace(SAFE_NAME, '_').slice(0, 120) : 'document.pdf';
  if (!fileName.toLowerCase().endsWith('.pdf')) fileName = `${fileName}.pdf`;
  const sha256 = crypto.createHash('sha256').update(bytes).digest('hex');
  return { ok: true, size: bytes.length, sha256, fileName };
}

