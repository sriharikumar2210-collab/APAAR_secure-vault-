/**
 * @license
 * SPDX-License-Identifier: Apache-2.0
 *
 * Regulator only: self-registered institutions waiting for approval.
 * Until approved they cannot register students, issue credentials or see any records.
 */

import React, { useCallback, useEffect, useState } from 'react';
import { Building2, CheckCircle2, XCircle, RefreshCw } from 'lucide-react';
import { realtimeClient } from '../services/realtimeClient';
import { formatIst } from '../utils/roleAccess';

interface PendingInstitution {
  id: string;
  name: string;
  email: string;
  organization: string;
  designation?: string;
  createdAt?: string;
}

export const InstitutionApprovalsPanel: React.FC<{ refreshKey?: number }> = ({ refreshKey = 0 }) => {
  const [items, setItems] = useState<PendingInstitution[]>([]);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState<string | null>(null);
  const [busy, setBusy] = useState<string | null>(null);
  const [lastDecision, setLastDecision] = useState<string | null>(null);

  const load = useCallback(async () => {
    setLoading(true);
    const r = await realtimeClient.listInstitutions('PENDING');
    if (r.ok && r.data) {
      setItems(r.data.institutions || []);
      setError(null);
    } else {
      setError(r.status === 0 || r.status === 503 ? 'Server offline: approvals cannot be loaded.' : r.error || 'Could not load.');
    }
    setLoading(false);
  }, []);

  useEffect(() => {
    load();
  }, [load, refreshKey]);

  const decide = async (inst: PendingInstitution, decision: 'APPROVE' | 'REJECT') => {
    setBusy(inst.id);
    const r = await realtimeClient.decideInstitution(inst.id, decision);
    setBusy(null);
    if (!r.ok) {
      setError(r.error || 'Could not save the decision.');
      return;
    }
    setItems(prev => prev.filter(i => i.id !== inst.id));
    setLastDecision(`${inst.organization} ${decision === 'APPROVE' ? 'approved' : 'rejected'}.`);
  };

  if (!loading && items.length === 0 && !error && !lastDecision) return null;

  return (
    <section className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-6">
      <div className="rounded-xl border border-purple-200 dark:border-purple-900/60 bg-purple-50 dark:bg-purple-950/30 p-4 space-y-3">
        <div className="flex items-center justify-between gap-2">
          <h2 className="text-sm font-bold text-purple-900 dark:text-purple-200 flex items-center gap-2">
            <Building2 className="w-4 h-4" />
            Institution accounts waiting for approval ({items.length})
          </h2>
          <button
            onClick={load}
            className="text-xs text-purple-800 dark:text-purple-300 flex items-center gap-1 hover:underline"
            aria-label="Refresh pending institutions"
          >
            <RefreshCw className={`w-3.5 h-3.5 ${loading ? 'animate-spin' : ''}`} />
            Refresh
          </button>
        </div>
        <p className="text-[11px] text-purple-900/80 dark:text-purple-200/80">
          Until approved, an institution cannot register students, issue credentials or view any student records. Check the
          institution and the person's official email before approving.
        </p>

        {error && <p className="text-xs text-rose-700 dark:text-rose-300">{error}</p>}
        {lastDecision && <p className="text-xs text-emerald-700 dark:text-emerald-300">{lastDecision}</p>}

        <div className="grid gap-2 sm:grid-cols-2">
          {items.map(inst => (
            <div
              key={inst.id}
              className="flex flex-col sm:flex-row sm:items-center justify-between gap-3 rounded-lg bg-white dark:bg-[#111927] border border-slate-200 dark:border-slate-800 p-3"
            >
              <div className="min-w-0 text-xs">
                <div className="font-bold text-slate-900 dark:text-white truncate">{inst.organization}</div>
                <div className="text-slate-600 dark:text-slate-400 truncate">
                  {inst.name}
                  {inst.designation ? ` · ${inst.designation}` : ''}
                </div>
                <div className="font-mono text-[11px] text-slate-500 truncate">{inst.email}</div>
                {inst.createdAt && <div className="text-[10px] text-slate-500">Signed up {formatIst(inst.createdAt)}</div>}
              </div>
              <div className="flex items-center gap-2 shrink-0">
                <button
                  onClick={() => decide(inst, 'REJECT')}
                  disabled={busy === inst.id}
                  className="flex items-center gap-1 px-2.5 py-1.5 rounded-lg text-xs font-semibold border border-rose-300 text-rose-700 bg-white hover:bg-rose-50 dark:bg-transparent dark:border-rose-800 dark:text-rose-300 disabled:opacity-50"
                >
                  <XCircle className="w-3.5 h-3.5" />
                  Reject
                </button>
                <button
                  onClick={() => decide(inst, 'APPROVE')}
                  disabled={busy === inst.id}
                  className="flex items-center gap-1 px-2.5 py-1.5 rounded-lg text-xs font-bold bg-emerald-600 hover:bg-emerald-500 text-white disabled:opacity-50"
                >
                  <CheckCircle2 className="w-3.5 h-3.5" />
                  Approve
                </button>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  );
};

