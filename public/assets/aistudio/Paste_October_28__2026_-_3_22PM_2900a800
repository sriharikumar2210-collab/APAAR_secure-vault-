export async function insertAuditLog(log: AuditLogEntry, actorUid: string | null): Promise<StoredAuditLog> {
  const run = auditChainQueue.then(() => insertChainedAuditLog(log, actorUid));
  auditChainQueue = run.catch(() => undefined);
  return run;
}

async function insertChainedAuditLog(log: AuditLogEntry, actorUid: string | null): Promise<StoredAuditLog> {
  const [last] = await db
    .select({ chainHash: auditLogs.chainHash })
    .from(auditLogs)
    .where(sql`${auditLogs.chainHash} IS NOT NULL`)
    .orderBy(desc(auditLogs.timestamp), desc(auditLogs.id))
    .limit(1);
  const prevHash = last?.chainHash || AUDIT_CHAIN_GENESIS;
  const chainHash = computeChainHash(prevHash, log.sha256Fingerprint);
  await db.insert(auditLogs).values({
    id: log.id,
    timestamp: log.timestamp,
    requestId: log.requestId || null,
    studentApaarId: log.studentApaarId,
    actor: log.actor,
    actorType: log.actorType,
    action: log.action,
    details: log.details,
    sha256Fingerprint: log.sha256Fingerprint,
    level: log.level,
    actorUid,
    prevHash,
    chainHash,
  });
  return { ...log, actorUid, prevHash, chainHash };
}

