 *
 * Institution / regulator view of a student's signed credentials.
 * Slots are built from the student's real credential records (no hard-coded list), so the
 * slot count, the dropdown and the "verified" total always agree.
 */

import React, { useEffect, useMemo, useState } from 'react';
import { Student, AcademicCredential, AuditLogEntry } from '../types';
import { verifyDigitalSignature } from '../utils/verificationEngine';
import { formatIst } from '../utils/roleAccess';
import { VaultDocumentForm, VaultFormValues } from './VaultDocumentForm';
import {
  FileCheck2,
  CheckCircle2,
  AlertTriangle,
  QrCode,
  Lock,
  Download,
  RefreshCw,
  BadgeCheck,
  Eye,
  Users,
} from 'lucide-react';

type SlotStatus = 'VERIFIED' | 'TAMPER_ALERT' | 'NOT_CHECKED' | 'SELF_UPLOAD';

interface SlotCheck {
  status: SlotStatus;
  checkedAt?: string;
  computedHash?: string;
  tamperReason?: string;
  /** What the tamper test changed, so the user sees exactly what was altered. */
  alteredField?: { field: string; original: string; altered: string };
}

interface DocumentVerificationViewProps {
  /** Students this user may see (already filtered by role). */
  students: Student[];
  canReverify: boolean;
  canRunTamperTest: boolean;
  onViewCertificateDetails: (credential: AcademicCredential) => void;
  /** Approved institutions: issue a signed credential. Returns an error message or null. */
  onSealCredential?: (apaarId: string, values: VaultFormValues) => Promise<string | null>;
  /** Self-registered institution not yet approved by the regulator. */
  awaitingApproval?: boolean;
  onLogAuditAction: (
    action: AuditLogEntry['action'],
    details: string,
    level: 'SUCCESS' | 'ALERT' | 'INFO',
    studentApaarId: string
  ) => void;
}

const CATEGORY: Record<AcademicCredential['type'], string> = {
  DEGREE: 'Higher Education',
  MARKSHEET: 'Higher Education',
  ABC_TRANSCRIPT: 'Credits',
  AICTE_APPROVAL: 'Regulatory',
  TRANSFER_CERTIFICATE: 'Schooling',
};

const TYPE_LABEL: Record<AcademicCredential['type'], string> = {
  DEGREE: 'Degree',
  MARKSHEET: 'Marksheet',
  ABC_TRANSCRIPT: 'ABC Credit Ledger',
  AICTE_APPROVAL: 'AICTE Approval',
  TRANSFER_CERTIFICATE: 'Transfer Certificate',
};

function signatureLabel(c: AcademicCredential): string {
  if (c.digitalSignature?.startsWith('SIG-PKI-HMAC-')) return 'HMAC-SHA256 (issuer-signed on server)';
  return 'SHA-256 integrity hash (sample data)';
}

const card = 'bg-white dark:bg-[#111927] border border-slate-200 dark:border-slate-800 rounded-xl shadow-sm';
const muted = 'text-slate-500 dark:text-slate-400';
const strong = 'text-slate-900 dark:text-white';

export const DocumentVerificationView: React.FC<DocumentVerificationViewProps> = ({
  students,
  canReverify,
  canRunTamperTest,
  onViewCertificateDetails,
  onSealCredential,
  awaitingApproval,
  onLogAuditAction,
}) => {
  const [isSealOpen, setIsSealOpen] = useState(false);
  const [sealNotice, setSealNotice] = useState<string | null>(null);
  // Institutions can open any student they registered (even with no credentials yet) to issue one.
  const candidates = useMemo(
    () => (onSealCredential ? students : students.filter(s => s.credentials.length > 0)),
    [students, onSealCredential]
  );
  const [selectedApaar, setSelectedApaar] = useState<string>(candidates[0]?.apaarId || '');
  const [activeCredId, setActiveCredId] = useState<string>('');
  const [filterCategory, setFilterCategory] = useState<string>('ALL');
  const [checks, setChecks] = useState<Record<string, SlotCheck>>({});
  const [busyId, setBusyId] = useState<string | null>(null);

  // Keep the selection valid when the visible student list changes.
  useEffect(() => {
    if (!candidates.some(s => s.apaarId === selectedApaar)) {
      setSelectedApaar(candidates[0]?.apaarId || '');
    }
  }, [candidates, selectedApaar]);

  const student = candidates.find(s => s.apaarId === selectedApaar);
  const slots = student?.credentials || [];
  const activeCred = slots.find(c => c.id === activeCredId) || slots[0];

  // First look: run the integrity check on every credential of the selected student.
  useEffect(() => {
    if (!student) return;
    setChecks(prev => {
      const next = { ...prev };
      for (const c of student.credentials) {
        const key = `${student.apaarId}:${c.id}`;
        if (!next[key] && c.source === 'SELF_UPLOAD') {
          next[key] = { status: 'SELF_UPLOAD', checkedAt: new Date().toISOString() };
        } else if (!next[key]) {
          const r = verifyDigitalSignature(c);
          next[key] = {
            status: r.isVerified ? 'VERIFIED' : 'TAMPER_ALERT',
            checkedAt: new Date().toISOString(),
            computedHash: r.computedHash,
            tamperReason: r.isVerified ? undefined : r.tamperReason,
          };
        }
      }
      return next;
    });
  }, [student]);

  if (awaitingApproval) {
    return (
      <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        <div className="rounded-xl border-2 border-amber-400 bg-amber-50 dark:bg-amber-950/30 p-8 text-center space-y-2">
          <Lock className="w-8 h-8 mx-auto text-amber-600" />
          <h1 className="text-base font-bold text-slate-900 dark:text-white">Waiting for regulator approval</h1>
          <p className="text-xs text-slate-700 dark:text-slate-300 max-w-lg mx-auto">
            Self-registered institution accounts must be approved by the AICTE / MoE regulator before they can register
            students, issue credentials or view any student records. You will get access automatically once approved.
          </p>
        </div>
      </div>
    );
  }

  if (student && !activeCred && onSealCredential) {
    return (
      <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-4">
        <div className={`${card} p-8 text-center space-y-3`}>
          <h1 className={`text-base font-bold ${strong}`}>{student.name} has no credentials yet</h1>
          <p className={`text-xs ${muted}`}>Issue the first signed credential for APAAR ID {student.apaarId}.</p>
          <button
            onClick={() => setIsSealOpen(true)}
            className="inline-flex items-center gap-1.5 px-4 py-2 rounded-lg text-xs font-bold bg-amber-500 hover:bg-amber-400 text-slate-950"
          >
            <Lock className="w-3.5 h-3.5" /> Issue signed credential
          </button>
          {candidates.length > 1 && (
            <select
              value={selectedApaar}
              onChange={e => setSelectedApaar(e.target.value)}
              className="block mx-auto mt-2 text-xs border border-slate-300 dark:border-slate-700 rounded px-2 py-1 bg-white dark:bg-slate-900"
            >
              {candidates.map(s => (
                <option key={s.apaarId} value={s.apaarId}>
                  {s.name} · {s.apaarId} ({s.credentials.length})
                </option>
              ))}
            </select>
          )}
        </div>
        {isSealOpen && (
          <VaultDocumentForm
            mode="ISSUE"
            studentName={student.name}
            onClose={() => setIsSealOpen(false)}
            onSubmit={values => onSealCredential(student.apaarId, values)}
          />
        )}
      </div>
    );
  }

  if (!student || !activeCred) {
    return (
      <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        <div className={`${card} p-10 text-center space-y-3`}>
          <Users className="w-10 h-10 mx-auto text-slate-400" />
          <h1 className={`text-base font-bold ${strong}`}>No credentials to inspect yet</h1>
          <p className={`text-xs ${muted} max-w-md mx-auto`}>
            This page lists the signed credentials of students your institution registered. Register a student and issue
            their credentials to see them here.
          </p>
        </div>
      </div>
    );
  }

  const keyOf = (c: AcademicCredential) => `${student.apaarId}:${c.id}`;
  const checkOf = (c: AcademicCredential): SlotCheck => checks[keyOf(c)] || { status: 'NOT_CHECKED' };
  const activeCheck = checkOf(activeCred);
  const isTampered = activeCheck.status === 'TAMPER_ALERT';

  const filteredSlots = slots
    .map((c, i) => ({ cred: c, number: i + 1 }))
    .filter(({ cred }) => filterCategory === 'ALL' || CATEGORY[cred.type] === filterCategory);

  const issuerSlots = slots.filter(c => c.source !== 'SELF_UPLOAD');
  const verifiedCount = issuerSlots.filter(c => checkOf(c).status === 'VERIFIED').length;
  const isSelfUpload = activeCred.source === 'SELF_UPLOAD';

  const handleReverify = (cred: AcademicCredential) => {
    setBusyId(cred.id);
    setTimeout(() => {
      const r = verifyDigitalSignature(cred);
      setChecks(prev => ({
        ...prev,
        [keyOf(cred)]: {
          status: r.isVerified ? 'VERIFIED' : 'TAMPER_ALERT',
          checkedAt: new Date().toISOString(),
          computedHash: r.computedHash,
          tamperReason: r.isVerified ? undefined : r.tamperReason,
        },
      }));
      setBusyId(null);
      onLogAuditAction(
        r.isVerified ? 'DIGITAL_SIGNATURE_VERIFIED' : 'SECURITY_TAMPER_ALERT',
        `Re-verified "${cred.title}" (${cred.id}): ${r.isVerified ? 'hash matches the issued record' : 'hash mismatch'}.`,
        r.isVerified ? 'SUCCESS' : 'ALERT',
        student.apaarId
      );
    }, 400);
  };

  // Tamper test: change one field on a COPY and run the same check. The stored record is untouched.
  const handleTamperTest = (cred: AcademicCredential) => {
    const altered = { ...cred, cgpaOrPercentage: `${cred.cgpaOrPercentage} (edited)` };
    const r = verifyDigitalSignature(altered);
    setChecks(prev => ({
      ...prev,
      [keyOf(cred)]: {
        status: r.isVerified ? 'VERIFIED' : 'TAMPER_ALERT',
        checkedAt: new Date().toISOString(),
        computedHash: r.computedHash,
        tamperReason: r.isVerified
          ? undefined
          : 'SHA-256 of the presented document does not match the hash recorded when it was issued. The score field was altered.',
        alteredField: { field: 'Score / CGPA', original: cred.cgpaOrPercentage, altered: altered.cgpaOrPercentage },
      },
    }));
    onLogAuditAction(
      'SECURITY_TAMPER_ALERT',
      `Tamper test on "${cred.title}" (${cred.id}): edited copy was rejected (hash mismatch).`,
      'ALERT',
      student.apaarId
    );
  };

  const statusBadge = (st: SlotStatus) =>
    st === 'VERIFIED' ? (
      <span className="inline-flex items-center gap-1 px-2 py-0.5 rounded text-[10px] font-bold shrink-0 bg-emerald-50 text-emerald-700 border border-emerald-200 dark:bg-emerald-950 dark:text-emerald-400 dark:border-emerald-800">
        <CheckCircle2 className="w-3 h-3" />
        Verified
      </span>
    ) : st === 'SELF_UPLOAD' ? (
      <span className="inline-flex items-center gap-1 px-2 py-0.5 rounded text-[10px] font-bold shrink-0 bg-slate-100 text-slate-700 border border-slate-300 dark:bg-slate-800 dark:text-slate-300 dark:border-slate-600">
        Student upload
      </span>
    ) : st === 'TAMPER_ALERT' ? (
      <span className="inline-flex items-center gap-1 px-2 py-0.5 rounded text-[10px] font-bold shrink-0 bg-rose-50 text-rose-700 border border-rose-300 dark:bg-rose-950 dark:text-rose-300 dark:border-rose-700">
        <AlertTriangle className="w-3 h-3" />
        Tampered
      </span>
    ) : (
      <span className="inline-flex items-center gap-1 px-2 py-0.5 rounded text-[10px] font-bold shrink-0 bg-slate-100 text-slate-600 border border-slate-200 dark:bg-slate-800 dark:text-slate-300 dark:border-slate-700">
        Not checked
      </span>
    );

  return (
    <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-8">
      {/* Top Banner */}
      <div className={`${card} p-6`}>
        <div className="flex flex-col md:flex-row md:items-center justify-between gap-4 border-b border-slate-200 dark:border-slate-800 pb-4">
          <div>
            <h1 className={`text-xl font-bold tracking-tight flex items-center gap-2 ${strong}`}>
              <FileCheck2 className="w-5 h-5 text-amber-500" />
              Academic Document Verification
            </h1>
            <p className={`text-xs mt-1 ${muted}`}>
              Each credential's SHA-256 hash is recomputed and compared with the hash recorded when it was issued.
              Server-issued credentials are also signed with HMAC-SHA256.
            </p>
          </div>

          <div className="flex flex-wrap items-center gap-2 self-start md:self-auto">
          {onSealCredential && (
            <button
              onClick={() => setIsSealOpen(true)}
              className="flex items-center gap-1.5 px-3 py-2 rounded-lg text-xs font-bold bg-amber-500 hover:bg-amber-400 text-slate-950"
            >
              <Lock className="w-3.5 h-3.5" />
              Issue signed credential
            </button>
          )}
          <label className="flex items-center gap-2 bg-slate-50 dark:bg-slate-900 p-2 rounded-lg border border-slate-200 dark:border-slate-800">
            <span className={`text-[11px] font-semibold ${muted}`}>Candidate:</span>
            <select
              value={selectedApaar}
              onChange={e => {
                setSelectedApaar(e.target.value);
                setActiveCredId('');
              }}
              className="bg-transparent text-xs font-bold text-amber-700 dark:text-amber-400 focus:outline-none cursor-pointer max-w-[260px]"
            >
              {candidates.map(s => (
                <option key={s.apaarId} value={s.apaarId}>
                  {s.name} · {s.apaarId} ({s.credentials.length})
                </option>
              ))}
            </select>
          </label>
          </div>
        </div>

        {sealNotice && (
          <div role="status" className="mt-4 p-3 rounded-lg text-xs bg-emerald-50 border border-emerald-200 text-emerald-800 dark:bg-emerald-950/40 dark:border-emerald-800 dark:text-emerald-300">
            {sealNotice}
          </div>
        )}

        <div className="grid grid-cols-2 sm:grid-cols-4 gap-4 mt-6 pt-2 text-xs">
          <div>
            <span className={`block ${muted}`}>Candidate</span>
            <strong className={`text-sm ${strong}`}>{student.name}</strong>
          </div>
          <div>
            <span className={`block ${muted}`}>APAAR ID</span>
            <span className="font-mono font-bold text-amber-700 dark:text-amber-400">{student.apaarId}</span>
          </div>
          <div className="min-w-0">
            <span className={`block ${muted}`}>Institution</span>
            <span className="block truncate text-slate-700 dark:text-slate-300" title={student.currentInstitution}>
              {student.currentInstitution}
            </span>
          </div>
          <div>
            <span className={`block ${muted}`}>Issuer-signed verified</span>
            <span
              className={`font-mono font-bold ${
                verifiedCount === issuerSlots.length ? 'text-emerald-700 dark:text-emerald-400' : 'text-rose-700 dark:text-rose-400'
              }`}
            >
              {verifiedCount} of {issuerSlots.length}
            </span>
            {slots.length > issuerSlots.length && (
              <span className={`block text-[10px] ${muted}`}>+ {slots.length - issuerSlots.length} student upload(s)</span>
            )}
          </div>
        </div>
      </div>

      <div className="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
        {/* Slot list */}
        <div className={`lg:col-span-5 ${card} p-5 space-y-4`}>
          <div className="flex items-center justify-between gap-2 border-b border-slate-200 dark:border-slate-800 pb-3">
            <h2 className={`text-sm font-bold flex items-center gap-2 ${strong}`}>
              <BadgeCheck className="w-4 h-4 text-amber-500" />
              Credentials ({slots.length})
            </h2>
            <select
              value={filterCategory}
              onChange={e => setFilterCategory(e.target.value)}
              className="bg-white dark:bg-slate-900 text-[11px] text-slate-700 dark:text-slate-300 border border-slate-300 dark:border-slate-700 rounded px-2 py-1 focus:outline-none focus:border-amber-500"
            >
              <option value="ALL">All categories</option>
              <option value="Higher Education">Higher education</option>
              <option value="Credits">Credits &amp; ABC</option>
              <option value="Regulatory">Regulatory</option>
              <option value="Schooling">Schooling</option>
            </select>
          </div>

          <div className="space-y-2.5">
            {filteredSlots.map(({ cred, number }) => {
              const isSelected = activeCred.id === cred.id;
              const st = checkOf(cred).status;
              return (
                <button
                  key={cred.id}
                  onClick={() => setActiveCredId(cred.id)}
                  title={cred.title}
                  className={`w-full text-left p-3.5 rounded-xl border transition-all text-xs space-y-1.5 ${
                    isSelected
                      ? 'bg-amber-50 border-amber-400 dark:bg-amber-950/40 dark:border-amber-500 shadow-sm'
                      : st === 'TAMPER_ALERT'
                      ? 'bg-rose-50 border-rose-200 dark:bg-rose-950/30 dark:border-rose-900'
                      : 'bg-slate-50 border-slate-200 hover:border-slate-300 dark:bg-slate-900/60 dark:border-slate-800 dark:hover:border-slate-700'
                  }`}
                >
                  <div className="flex items-start justify-between gap-2">
                    <span className={`font-bold text-xs line-clamp-2 ${strong}`}>
                      {number}. {cred.title}
                    </span>
                    {statusBadge(st)}
                  </div>
                  <div className={`flex flex-wrap items-center gap-x-2 gap-y-1 text-[11px] ${muted}`}>
                    <span className="truncate max-w-[220px]">{cred.issuingInstitution}</span>
                    <span aria-hidden="true">·</span>
                    <span className="font-mono text-amber-700 dark:text-amber-400">{cred.yearOfPassing}</span>
                    <span aria-hidden="true">·</span>
                    <span>{CATEGORY[cred.type]}</span>
                  </div>
                </button>
              );
            })}
          </div>
        </div>

        {/* Inspector */}
        <div className={`lg:col-span-7 ${card} p-6 space-y-6`}>
          <div className="flex flex-col sm:flex-row sm:items-start justify-between gap-3 border-b border-slate-200 dark:border-slate-800 pb-4">
            <div className="min-w-0">
              <span className="text-[10px] uppercase font-bold text-amber-700 dark:text-amber-400 tracking-wider">
                Credential inspector
              </span>
              <h3 className={`text-base font-bold mt-0.5 ${strong}`}>{activeCred.title}</h3>
            </div>

            <div className="flex items-center gap-2 shrink-0">
              {canReverify && !isSelfUpload && (
                <button
                  onClick={() => handleReverify(activeCred)}
                  disabled={busyId === activeCred.id}
                  className="flex items-center gap-1.5 px-3 py-1.5 bg-emerald-600 hover:bg-emerald-500 disabled:opacity-60 text-white font-bold rounded-lg text-xs transition-colors"
                >
                  <RefreshCw className={`w-3.5 h-3.5 ${busyId === activeCred.id ? 'animate-spin' : ''}`} />
                  <span>Re-verify</span>
                </button>
              )}
              {canRunTamperTest && !isSelfUpload && (
                <button
                  onClick={() => handleTamperTest(activeCred)}
                  className="flex items-center gap-1.5 px-3 py-1.5 bg-rose-50 hover:bg-rose-100 border border-rose-300 text-rose-700 dark:bg-rose-950/60 dark:hover:bg-rose-900 dark:border-rose-800 dark:text-rose-300 font-semibold rounded-lg text-xs transition-colors"
                  title="Edit a copy of this credential and show that the check rejects it"
                >
                  <AlertTriangle className="w-3.5 h-3.5" />
                  <span>Test tamper</span>
                </button>
              )}
            </div>
          </div>

          {isSelfUpload && (
            <div className="p-3 rounded-lg text-xs bg-slate-50 border border-slate-300 text-slate-700 dark:bg-slate-900 dark:border-slate-700 dark:text-slate-300">
              Uploaded by the student. It is fingerprinted (SHA-256) but <strong>not signed by an issuer</strong>, so it is not
              counted as verified and employers do not see it. Issue a signed credential to replace it.
            </div>
          )}

          {isTampered && (
            <div
              role="alert"
              className="p-4 rounded-xl border-2 space-y-2 text-xs bg-rose-50 border-rose-500 text-rose-800 dark:bg-rose-950/70 dark:border-rose-600 dark:text-rose-200"
            >
              <div className="font-bold flex items-center gap-2 text-sm">
                <AlertTriangle className="w-5 h-5 shrink-0" />
                <span>Tampered — this document does not match the issued record</span>
              </div>
              <p className="leading-relaxed text-[11px]">{activeCheck.tamperReason}</p>
              {activeCheck.alteredField && (
                <p className="text-[11px] font-mono">
