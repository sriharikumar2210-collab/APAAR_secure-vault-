import React, { useMemo, useState } from 'react';
import { AuditLogEntry } from '../types';
import { generateHash } from '../utils/verificationEngine';
import { formatIst } from '../utils/roleAccess';
import {
  History,
  Download,
  CheckCircle2,
  AlertTriangle,
  Info,
  Lock,
  Link2,
  Copy,
  ShieldCheck,
  ShieldAlert,
} from 'lucide-react';

interface AuditTrailViewProps {
  logs: AuditLogEntry[];
  /** Which events this role is allowed to see (shown under the title). */
  scopeLabel?: string;
  initialFilterRequestId?: string;
}

/**
 * Older databases stored sign-in events as PREFERENCES_UPDATED with "AUTH_GATEWAY" in the
 * candidate column. They are shown with the correct action here; the stored rows are not
 * rewritten, because changing them would break their fingerprints.
 */
function displayAction(log: AuditLogEntry): AuditLogEntry['action'] {
  if (log.action === 'PREFERENCES_UPDATED' && /^signed in/i.test(log.details)) {
    return /new account registration/i.test(log.details) ? 'ACCOUNT_REGISTERED' : 'AUTH_LOGIN';
  }
  if (log.action === 'PREFERENCES_UPDATED' && /^signed out/i.test(log.details)) return 'AUTH_LOGOUT';
  return log.action;
}

function displayApaar(log: AuditLogEntry): string {
  const v = (log.studentApaarId || '').trim();
  return !v || v === 'AUTH_GATEWAY' ? '—' : v;
}

const ACTOR_LABEL: Record<AuditLogEntry['actorType'], string> = {
  EMPLOYER: 'EMPLOYER',
  STUDENT: 'STUDENT',
  INSTITUTION: 'INSTITUTION',
  REGULATOR: 'REGULATOR',
  SYSTEM: 'SYSTEM',
  AICTE_GATEWAY: 'AICTE GATEWAY',
  DIGILOCKER_NAD: 'DIGILOCKER / NAD',
};

type ChainState = 'linked' | 'broken' | 'local';

/** Server entries carry a hash chain; recompute it to show whether each entry is intact. */
function checkChain(log: AuditLogEntry): ChainState {
  if (!log.chainHash || !log.prevHash) return 'local';
  const fingerprint = generateHash(
    [log.id, log.timestamp, log.actor, log.action, log.studentApaarId, log.details, log.requestId || ''].join('|')
  );
  if (fingerprint !== log.sha256Fingerprint) return 'broken';
  return generateHash(`${log.prevHash}|${log.sha256Fingerprint}`) === log.chainHash ? 'linked' : 'broken';
}

const LEVEL_STYLE: Record<AuditLogEntry['level'], { label: string; cls: string; icon: React.ReactNode }> = {
  SUCCESS: {
    label: 'Success',
    cls: 'bg-emerald-50 text-emerald-700 border-emerald-200 dark:bg-emerald-950/80 dark:text-emerald-400 dark:border-emerald-800',
    icon: <CheckCircle2 className="w-3 h-3" />,
  },
  ALERT: {
    label: 'Alert',
    cls: 'bg-rose-50 text-rose-700 border-rose-200 dark:bg-rose-950/80 dark:text-rose-400 dark:border-rose-800',
    icon: <AlertTriangle className="w-3 h-3" />,
  },
  INFO: {
    label: 'Info',
    cls: 'bg-slate-100 text-slate-700 border-slate-200 dark:bg-slate-800 dark:text-slate-300 dark:border-slate-700',
    icon: <Info className="w-3 h-3" />,
  },
};

export const AuditTrailView: React.FC<AuditTrailViewProps> = ({ logs, scopeLabel, initialFilterRequestId }) => {
  const [searchTerm, setSearchTerm] = useState(initialFilterRequestId || '');
  const [selectedActorType, setSelectedActorType] = useState<string>('ALL');
  const [selectedLevel, setSelectedLevel] = useState<string>('ALL');
  const [copiedId, setCopiedId] = useState<string | null>(null);

  const chainByLogId = useMemo(() => {
    const map = new Map<string, ChainState>();
    for (const l of logs) map.set(l.id, checkChain(l));
    return map;
  }, [logs]);

  const chainSummary = useMemo(() => {
    let linked = 0;
    let broken = 0;
    for (const v of chainByLogId.values()) {
      if (v === 'linked') linked++;
      if (v === 'broken') broken++;
    }
    return { linked, broken };
  }, [chainByLogId]);

  const sortedLogs = useMemo(
    () => [...logs].sort((a, b) => Date.parse(b.timestamp) - Date.parse(a.timestamp)),
    [logs]
  );

  const filteredLogs = sortedLogs.filter(log => {
    if (searchTerm.trim()) {
      const q = searchTerm.toLowerCase();
      const hay = [log.requestId, log.studentApaarId, log.actor, log.details, displayAction(log)]
        .filter(Boolean)
        .join(' ')
        .toLowerCase();
      if (!hay.includes(q)) return false;
    }
    if (selectedActorType !== 'ALL' && log.actorType !== selectedActorType) return false;
    if (selectedLevel !== 'ALL' && log.level !== selectedLevel) return false;
    return true;
