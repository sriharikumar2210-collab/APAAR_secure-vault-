/** Genesis value for the audit hash chain. */
export const AUDIT_CHAIN_GENESIS = '0'.repeat(64);

export function computeChainHash(prevHash: string, fingerprint: string): string {
  return createHash('sha256').update(`${prevHash}|${fingerprint}`).digest('hex');
}

// Audit inserts are serialised so every entry links to exactly one predecessor.
let auditChainQueue: Promise<unknown> = Promise.resolve();


export async function getAllAuditLogsStored(): Promise<StoredAuditLog[]> {
  const rows = await db.select().from(auditLogs).orderBy(desc(auditLogs.timestamp));
  return rows.map(mapAudit);
