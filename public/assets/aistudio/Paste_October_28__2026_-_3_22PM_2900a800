/**
 * @license
 * SPDX-License-Identifier: Apache-2.0
 *
 * Small dialog used for both:
 *  - a student adding their own copy of a document (PDF required, stored as "not issuer-verified"), and
 *  - an institution issuing (sealing) a signed credential (PDF optional).
 * The PDF is checked here first (type, size, completeness) and again on the server.
 */

import React, { useState } from 'react';
import { X, Upload, FileText, Lock } from 'lucide-react';
import { AcademicCredential } from '../types';
import { readPdfForVault, VaultFile, MAX_PDF_BYTES } from '../utils/vaultRules';

export interface VaultFormValues {
  credential: Pick<AcademicCredential, 'type' | 'title' | 'yearOfPassing' | 'cgpaOrPercentage' | 'specialization'>;
  file?: VaultFile;
}

interface Props {
  mode: 'SELF_UPLOAD' | 'ISSUE';
  studentName: string;
  onClose: () => void;
  /** Returns an error message to show, or null on success. */
  onSubmit: (values: VaultFormValues) => Promise<string | null>;
}

const TYPES: { value: AcademicCredential['type']; label: string }[] = [
  { value: 'DEGREE', label: 'Degree certificate' },
  { value: 'MARKSHEET', label: 'Marksheet / grade statement' },
  { value: 'ABC_TRANSCRIPT', label: 'ABC credit transcript' },
  { value: 'AICTE_APPROVAL', label: 'AICTE approval' },
  { value: 'TRANSFER_CERTIFICATE', label: 'Transfer certificate' },
];

const input =
  'w-full rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-900 px-3 py-2 text-xs text-slate-900 dark:text-white focus:outline-none focus:border-amber-500';

export const VaultDocumentForm: React.FC<Props> = ({ mode, studentName, onClose, onSubmit }) => {
  const [type, setType] = useState<AcademicCredential['type']>('MARKSHEET');
  const [title, setTitle] = useState('');
  const [year, setYear] = useState<string>(String(new Date().getFullYear()));
  const [score, setScore] = useState('');
  const [specialization, setSpecialization] = useState('');
  const [file, setFile] = useState<VaultFile | undefined>();
  const [fileInfo, setFileInfo] = useState<string | null>(null);
  const [error, setError] = useState<string | null>(null);
  const [busy, setBusy] = useState(false);

  const fileRequired = mode === 'SELF_UPLOAD';

  const onPickFile = async (f: File | undefined) => {
    setError(null);
    setFile(undefined);
    setFileInfo(null);
    if (!f) return;
    const r = await readPdfForVault(f);
    if (!r.ok) {
      setError(r.error);
      return;
    }
    setFile(r.file);
    setFileInfo(`${f.name} · ${(r.size / 1024).toFixed(1)} KB`);
  };

  const submit = async (e: React.FormEvent) => {
    e.preventDefault();
    const y = Number(year);
    if (title.trim().length < 3) return setError('Enter the document title.');
    if (!Number.isInteger(y) || y < 1950 || y > 2100) return setError('Enter a valid year.');
    if (!score.trim()) return setError('Enter the score, CGPA or result.');
    if (fileRequired && !file) return setError('Attach the PDF.');
    setBusy(true);
    const problem = await onSubmit({
      credential: { type, title: title.trim(), yearOfPassing: y, cgpaOrPercentage: score.trim(), specialization: specialization.trim() },
      file,
    });
    setBusy(false);
    if (problem) setError(problem);
    else onClose();
  };

  return (
    <div className="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-950/70 backdrop-blur-sm" role="dialog" aria-modal="true">
      <form
        onSubmit={submit}
        className="w-full max-w-lg rounded-xl bg-white dark:bg-[#111927] border border-slate-200 dark:border-slate-800 shadow-2xl p-5 space-y-4"
      >
        <div className="flex items-start justify-between gap-3">
          <div>
            <h2 className="text-sm font-bold text-slate-900 dark:text-white flex items-center gap-2">
              {mode === 'ISSUE' ? <Lock className="w-4 h-4 text-amber-500" /> : <Upload className="w-4 h-4 text-amber-500" />}
              {mode === 'ISSUE' ? 'Issue a signed credential' : 'Add a document to my vault'}
            </h2>
            <p className="text-[11px] text-slate-600 dark:text-slate-400 mt-0.5">
              {mode === 'ISSUE'
                ? `For ${studentName}. The server signs it with the institution key (HMAC-SHA256). If you attach the PDF, its SHA-256 is part of the signature.`
                : 'Your own copy is stored with its SHA-256 fingerprint and marked “not issuer-verified”. Employers only see credentials signed by your institution.'}
            </p>
          </div>
          <button type="button" onClick={onClose} aria-label="Close" className="text-slate-400 hover:text-slate-700 dark:hover:text-white">
            <X className="w-4 h-4" />
          </button>
        </div>

        <div className="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs">
          <label className="space-y-1 sm:col-span-2">
            <span className="font-semibold text-slate-700 dark:text-slate-300">Document type</span>
            <select value={type} onChange={e => setType(e.target.value as AcademicCredential['type'])} className={input}>
              {TYPES.map(t => (
                <option key={t.value} value={t.value}>
                  {t.label}
                </option>
              ))}
            </select>
          </label>
          <label className="space-y-1 sm:col-span-2">
            <span className="font-semibold text-slate-700 dark:text-slate-300">Title</span>
            <input value={title} onChange={e => setTitle(e.target.value)} className={input} placeholder="e.g. Consolidated Statement of Grades (Semesters 1-8)" />
          </label>
          <label className="space-y-1">
            <span className="font-semibold text-slate-700 dark:text-slate-300">Year</span>
            <input value={year} onChange={e => setYear(e.target.value.replace(/\D/g, '').slice(0, 4))} className={input} inputMode="numeric" />
          </label>
          <label className="space-y-1">
            <span className="font-semibold text-slate-700 dark:text-slate-300">Score / CGPA / result</span>
            <input value={score} onChange={e => setScore(e.target.value)} className={input} placeholder="e.g. 8.82 CGPA" />
          </label>
          <label className="space-y-1 sm:col-span-2">
            <span className="font-semibold text-slate-700 dark:text-slate-300">Specialisation (optional)</span>
            <input value={specialization} onChange={e => setSpecialization(e.target.value)} className={input} />
          </label>
          <label className="space-y-1 sm:col-span-2">
            <span className="font-semibold text-slate-700 dark:text-slate-300">
              PDF {fileRequired ? '(required)' : '(optional)'} · max {MAX_PDF_BYTES / 1024 / 1024} MB
            </span>
            <input type="file" accept="application/pdf,.pdf" onChange={e => onPickFile(e.target.files?.[0])} className="block w-full text-xs text-slate-700 dark:text-slate-300" />
            {fileInfo && (
              <span className="flex items-center gap-1 text-emerald-700 dark:text-emerald-400">
                <FileText className="w-3.5 h-3.5" />
                {fileInfo} · PDF check passed
              </span>
            )}
          </label>
        </div>

        {error && (
          <p role="alert" className="text-xs text-rose-700 dark:text-rose-300 bg-rose-50 dark:bg-rose-950/40 border border-rose-200 dark:border-rose-900 rounded-lg p-2">
            {error}
          </p>
        )}

        <div className="flex justify-end gap-2">
          <button type="button" onClick={onClose} className="px-3 py-2 rounded-lg text-xs font-semibold border border-slate-300 dark:border-slate-700 text-slate-700 dark:text-slate-200">
            Cancel
          </button>
          <button type="submit" disabled={busy} className="px-4 py-2 rounded-lg text-xs font-bold bg-amber-500 hover:bg-amber-400 text-slate-950 disabled:opacity-60">
            {busy ? 'Saving…' : mode === 'ISSUE' ? 'Sign & issue' : 'Add to vault'}
          </button>
        </div>
      </form>
    </div>
  );
};

