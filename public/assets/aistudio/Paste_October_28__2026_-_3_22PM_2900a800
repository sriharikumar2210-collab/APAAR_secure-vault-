/**
 * @license
 * SPDX-License-Identifier: Apache-2.0
 *
 * PDF rules for the APAAR Secure Vault, shared by the browser (early feedback)
 * and the server (the check that counts).
 */

export const MIN_PDF_BYTES = 1024; // a real one-page PDF is never smaller than 1 KB
export const MAX_PDF_BYTES = 5 * 1024 * 1024; // 5 MB

/** A file sent to the vault: base64 contents plus its original name. */
export interface VaultFile {
  name: string;
  base64: string;
}

function ascii(bytes: Uint8Array, start: number, end: number): string {
  let out = '';
  for (let i = Math.max(0, start); i < Math.min(bytes.length, end); i++) out += String.fromCharCode(bytes[i]);
  return out;
}

/** Returns an error message, or null when the bytes look like a complete PDF of an allowed size. */
export function pdfProblem(bytes: Uint8Array): string | null {
  const size = bytes.length;
  if (size < MIN_PDF_BYTES) {
    return `The file is too small (${size} bytes) to be a real document. Upload the actual PDF.`;
  }
  if (size > MAX_PDF_BYTES) return 'The file is larger than 5 MB.';
  if (ascii(bytes, 0, 5) !== '%PDF-') return 'This is not a PDF file (a renamed file is not accepted).';
  if (!ascii(bytes, size - 1024, size).includes('%%EOF')) return 'The PDF looks incomplete or damaged.';
  return null;
}

/** Browser helper: reads a chosen file, checks it, and returns it ready to send. */
export async function readPdfForVault(file: File): Promise<{ ok: true; file: VaultFile; size: number } | { ok: false; error: string }> {
  if (file.size > MAX_PDF_BYTES) return { ok: false, error: 'The file is larger than 5 MB.' };
  const bytes = new Uint8Array(await file.arrayBuffer());
  const problem = pdfProblem(bytes);
  if (problem) return { ok: false, error: problem };
  let binary = '';
  const chunk = 0x8000;
  for (let i = 0; i < bytes.length; i += chunk) {
    binary += String.fromCharCode(...bytes.subarray(i, i + chunk));
  }
  return { ok: true, file: { name: file.name, base64: btoa(binary) }, size: bytes.length };
}

