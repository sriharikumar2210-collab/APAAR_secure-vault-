  /** Institution seals (issues) a signed credential, optionally with the PDF, for a student it registered. */
  app.post('/api/db/students/:apaarId/credentials', requireAuth, async (req: AuthRequest, res: Response) => {
    try {
      const caller = req.user!;
      if (caller.role !== 'INSTITUTION') {
        return res.status(403).json({ error: 'Only an institution can issue credentials.' });
      }
      const student = await getStudentStored(String(req.params.apaarId));
      if (!student) return res.status(404).json({ error: 'No student with this APAAR ID.' });
      const decision = canWriteStudent(caller, student, student);
      if (!decision.ok) return res.status(decision.status).json({ error: decision.error });

      const base = sanitizeCredential({ ...req.body?.credential, id: undefined }, caller.organization);
      if (!base) return res.status(400).json({ error: 'Enter the document type, title, year and score.' });
      let fileFields: Partial<AcademicCredential> = {};
      if (req.body?.file) {
        const pdf = checkPdfUpload(req.body.file.base64, req.body.file.name);
        if (!pdf.ok) return res.status(400).json({ error: pdf.error });
        fileFields = { fileName: pdf.fileName, fileSize: pdf.size, fileSha256: pdf.sha256 };
      }
      const credential = signCredential({
        ...base,
        ...fileFields,
        issuingInstitution: caller.organization,
        issuingAuthority: `${caller.name}, ${caller.organization}`,
        digilockerUri: `vault://apaar-registry/${digitsOnly(student.apaarId)}/${base.type.toLowerCase()}/${base.id}`,
        source: 'ISSUER' as const,
      });
      await insertCredentials(student.apaarId, [credential]);
      const saved = (await getStudentStored(student.apaarId))!;
      const log = await insertAuditLog(
        buildAuditEntry({
          actor: `${caller.name} (${caller.organization})`,
          actorType: 'INSTITUTION',
          action: 'CREDENTIAL_SEALED',
          studentApaarId: student.apaarId,
          details: `Issued and signed "${credential.title}" (${credential.id}) for ${student.name}${
            credential.fileSha256 ? `, PDF ${credential.fileName} (${credential.fileSize} bytes, SHA-256 ${credential.fileSha256.slice(0, 16)}…)` : ''
          }.`,
          level: 'SUCCESS',
        }),
        caller.uid
      );
      const ctx: EventContext = { studentApaarId: saved.apaarId, studentCreatedBy: saved.createdByUid, actorUid: caller.uid };
      broadcast('student:upserted', saved, ctx);
      broadcast('audit:created', log, ctx);
      res.status(201).json({ student: filterStudentsForCaller([saved], [], caller)[0] ?? null, credential });
    } catch (err) {
      console.error('Sealing credential failed:', err);
      res.status(500).json({ error: 'Could not issue the credential.' });
    }
  });

