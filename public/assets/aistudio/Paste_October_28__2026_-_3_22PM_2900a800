// ---------------------------------------------------------------------------
// Sample dates are relative to when the app starts (same rule the server uses when it seeds
// the database), so open sample requests are never already expired and the request time,
// the audit trail and the employer page all show the same moment.
// ---------------------------------------------------------------------------
const HOUR = 3600 * 1000;
const START = Date.now();
const iso = (ms: number) => new Date(ms).toISOString();

export const INITIAL_VERIFICATION_REQUESTS: VerificationRequest[] = REQUEST_TEMPLATES.map((req, i) => {
  const stillOpen = ['PENDING_STUDENT_CONSENT', 'CONSENT_GRANTED', 'VERIFYING', 'VERIFIED'].includes(req.status);
  const requestedAt = START - (2 + i * 24) * HOUR;
  return {
    ...req,
    requestedAt: iso(requestedAt),
    consentGrantedAt: req.consentGrantedAt ? iso(requestedAt + HOUR) : undefined,
    consentRevokedAt: req.consentRevokedAt ? iso(requestedAt + 2 * HOUR) : undefined,
    consentExpiresAt: iso(stillOpen ? START + 72 * HOUR : requestedAt + 24 * HOUR),
    backendValidation: req.backendValidation
      ? { ...req.backendValidation, verifiedAt: iso(requestedAt + HOUR + 30 * 1000) }
      : undefined,
  };
});

const requestById = new Map(INITIAL_VERIFICATION_REQUESTS.map(r => [r.id, r]));
const AUDIT_OFFSETS: Record<string, (r: VerificationRequest) => number> = {
  'AUDIT-LOG-101': r => Date.parse(r.requestedAt),
  'AUDIT-LOG-102': r => Date.parse(r.requestedAt) + 5 * 1000,
  'AUDIT-LOG-103': r => Date.parse(r.consentGrantedAt || r.requestedAt),
  'AUDIT-LOG-104': r => Date.parse(r.consentGrantedAt || r.requestedAt) + 16 * 1000,
  'AUDIT-LOG-105': r => Date.parse(r.consentGrantedAt || r.requestedAt) + 30 * 1000,
  'AUDIT-LOG-106': r => Date.parse(r.consentRevokedAt || r.requestedAt),
};

export const INITIAL_AUDIT_LOGS: AuditLogEntry[] = AUDIT_TEMPLATES.map(log => {
  const req = log.requestId ? requestById.get(log.requestId) : undefined;
  const at = req && AUDIT_OFFSETS[log.id] ? AUDIT_OFFSETS[log.id](req) : Date.parse(log.timestamp);
  return { ...log, timestamp: iso(at) };
}).sort((a, b) => Date.parse(b.timestamp) - Date.parse(a.timestamp));

