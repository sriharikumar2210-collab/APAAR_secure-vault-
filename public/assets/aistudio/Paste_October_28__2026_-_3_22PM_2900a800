/**
 * @license
 * SPDX-License-Identifier: Apache-2.0
 *
 * Role-based access for the browser.
 *
 * The server (src/server/accessRules.ts) is the real gatekeeper: it filters every read and
 * refuses every write the caller may not make. This file mirrors those rules on the screen so
 * that each role only sees the pages, buttons and records it is allowed to use — including the
 * local sample data shown before (or without) a server connection.
 */

import type { UserAccount, UserRole } from '../types/auth';
import type { Student, VerificationRequest, AuditLogEntry } from '../types';

export type AppTab =
  | 'employer-bgv'
  | 'doc-verification'
  | 'student-portal'
  | 'registry'
  | 'lookup'
  | 'insights'
  | 'audit-trail';

/** Pages each role may open, in the order they appear in the top navigation. */
export const ROLE_TABS: Record<UserRole, AppTab[]> = {
  STUDENT: ['student-portal', 'audit-trail'],
  EMPLOYER: ['employer-bgv', 'audit-trail'],
  INSTITUTION: ['doc-verification', 'registry', 'lookup', 'insights', 'audit-trail'],
  REGULATOR: ['audit-trail', 'registry', 'lookup', 'insights'],
};

/** The page a role lands on after sign-in. */
export const ROLE_HOME_TAB: Record<UserRole, AppTab> = {
  STUDENT: 'student-portal',
  EMPLOYER: 'employer-bgv',
  INSTITUTION: 'doc-verification',
  REGULATOR: 'audit-trail',
};

export function canOpenTab(role: UserRole, tab: AppTab): boolean {
  return ROLE_TABS[role].includes(tab);
}

/** What each role may do on screen. */
export interface RoleCapabilities {
  /** Register students / issue signed credentials (institutions only). */
  canRegisterStudent: boolean;
  /** Grant, reject or revoke consent (only the student named on a request). */
  canDecideConsent: boolean;
  /** Receives the "employer requested your records" alerts. */
  receivesStudentAlerts: boolean;
  /** May run the tamper-detection demo on a credential slot. */
  canRunTamperTest: boolean;
  /** May re-verify a credential slot against the issuer. */
  canReverifySlot: boolean;
  /** Issue (seal) a signed credential into a student's vault (approved institutions only). */
  canSealCredential: boolean;
  /** Add their own document copy to their vault (students; marked not issuer-verified). */
  canUploadOwnDocument: boolean;
  /** Approve or reject self-registered institutions (regulator only). */
  canApproveInstitutions: boolean;
  /** True for a self-registered institution still waiting for the regulator. */
  isAwaitingApproval: boolean;
  /** Short label shown on the audit page. */
  auditScopeLabel: string;
}

export function getCapabilities(
  role: UserRole,
  approvalStatus: UserAccount['approvalStatus'] = 'APPROVED'
): RoleCapabilities {
  const activeInstitution = role === 'INSTITUTION' && approvalStatus === 'APPROVED';
  return {
    canRegisterStudent: activeInstitution,
    canSealCredential: activeInstitution,
    canUploadOwnDocument: role === 'STUDENT',
    canApproveInstitutions: role === 'REGULATOR',
    isAwaitingApproval: role === 'INSTITUTION' && approvalStatus !== 'APPROVED',
    canDecideConsent: role === 'STUDENT',
    receivesStudentAlerts: role === 'STUDENT',
    canRunTamperTest: activeInstitution || role === 'REGULATOR',
    canReverifySlot: activeInstitution,
    auditScopeLabel:
      role === 'REGULATOR'
        ? 'All events across the registry'
        : role === 'STUDENT'
        ? 'Events about your APAAR ID only'
        : role === 'EMPLOYER'
        ? 'Events for your organisation’s requests only'
        : 'Events for students your institution registered',
  };
}

// ---------------------------------------------------------------------------
// Ownership helpers (mirror of the server rules, for local sample data)
// ---------------------------------------------------------------------------

export function digitsOnly(value: string | null | undefined): string {
  return String(value || '').replace(/\D/g, '');
}

export function sameApaar(a: string | null | undefined, b: string | null | undefined): boolean {
  const x = digitsOnly(a);
  return x.length === 12 && x === digitsOnly(b);
}

const norm = (s: string | null | undefined) => String(s || '').toLowerCase().replace(/[^a-z0-9]+/g, ' ').trim();

/** Main words of an organisation name, e.g. "Anna University, Chennai" -> "anna university". */
function orgKey(organization: string): string {
  return norm(organization.split(',')[0]);
}

function institutionMatchesStudent(user: UserAccount, student: Student): boolean {
  const key = orgKey(user.organization);
  if (!key) return false;
  if (norm(student.currentInstitution).includes(key)) return true;
  return student.credentials.some(
    c => norm(c.issuingInstitution).includes(key) || norm(c.issuingAuthority).includes(key)
  );
}

export function isOwnRequestForEmployer(user: UserAccount, req: VerificationRequest): boolean {
  return norm(req.employerName) === norm(user.organization);
}

/** Students this user may see. */
export function scopeStudents(
  students: Student[],
  requests: VerificationRequest[],
  user: UserAccount
): Student[] {
  switch (user.role) {
    case 'REGULATOR':
      return students;
    case 'STUDENT':
      return students.filter(s => sameApaar(s.apaarId, user.apaarId));
    case 'INSTITUTION':
      if (user.approvalStatus && user.approvalStatus !== 'APPROVED') return [];
      return students.filter(s => institutionMatchesStudent(user, s));
    case 'EMPLOYER': {
      const mine = requests.filter(r => isOwnRequestForEmployer(user, r));
      return students
        .filter(s => mine.some(r => sameApaar(r.studentApaarId, s.apaarId)))
        .map(s => ({ ...s, contactEmail: '', contactPhone: '' }));
    }
    default:
      return [];
  }
}

/** Verification requests this user may see. */
export function scopeRequests(
  requests: VerificationRequest[],
  students: Student[],
  user: UserAccount
): VerificationRequest[] {
  switch (user.role) {
    case 'REGULATOR':
      return requests;
    case 'STUDENT':
      return requests.filter(r => sameApaar(r.studentApaarId, user.apaarId));
    case 'EMPLOYER':
      return requests.filter(r => isOwnRequestForEmployer(user, r));
    case 'INSTITUTION': {
      const mineIds = new Set(scopeStudents(students, requests, user).map(s => digitsOnly(s.apaarId)));
      return requests.filter(r => mineIds.has(digitsOnly(r.studentApaarId)));
    }
    default:
      return [];
  }
}

/** Audit entries this user may see. */
export function scopeAuditLogs(
  logs: AuditLogEntry[],
  requests: VerificationRequest[],
  students: Student[],
  user: UserAccount
): AuditLogEntry[] {
  if (user.role === 'REGULATOR') return logs;
  const actorIsMe = (l: AuditLogEntry) =>
    norm(l.actor).startsWith(norm(user.name)) || norm(l.actor).includes(`${norm(user.name)} ${norm(user.role)}`);

  switch (user.role) {
    case 'STUDENT':
      return logs.filter(l => sameApaar(l.studentApaarId, user.apaarId) || actorIsMe(l));
    case 'EMPLOYER': {
      const myRequestIds = new Set(requests.filter(r => isOwnRequestForEmployer(user, r)).map(r => r.id));
      return logs.filter(l => (l.requestId && myRequestIds.has(l.requestId)) || actorIsMe(l));
    }
    case 'INSTITUTION': {
      const mine = new Set(scopeStudents(students, requests, user).map(s => digitsOnly(s.apaarId)));
      return logs.filter(l => mine.has(digitsOnly(l.studentApaarId)) || actorIsMe(l));
    }
    default:
      return [];
  }
}

/** First name for compact display, skipping honorifics/initials ("Dr. K. Ravichandran" -> "Ravichandran"). */
export function displayShortName(fullName: string): string {
  const parts = fullName
    .replace(/\(.*?\)/g, '')
    .split(/\s+/)
    .filter(Boolean);
  const honorifics = new Set(['dr', 'dr.', 'prof', 'prof.', 'mr', 'mr.', 'mrs', 'mrs.', 'ms', 'ms.', 'shri', 'smt', 'smt.']);
  const meaningful = parts.filter(p => !honorifics.has(p.toLowerCase()) && !/^[A-Za-z]\.?$/.test(p));
  return meaningful[0] || parts[parts.length - 1] || fullName;
}

/** Formats a timestamp in Indian Standard Time regardless of the viewer's computer clock. */
export function formatIst(
  iso: string,
  part: 'date' | 'time' | 'datetime' = 'datetime'
): string {
  const d = new Date(iso);
  if (Number.isNaN(d.getTime())) return '—';
  const date = d.toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric', timeZone: 'Asia/Kolkata' });
  const time = d.toLocaleTimeString('en-IN', {
    hour: '2-digit',
    minute: '2-digit',
    second: part === 'time' ? '2-digit' : undefined,
    hour12: true,
    timeZone: 'Asia/Kolkata',
  });
  if (part === 'date') return date;
  if (part === 'time') return `${time} IST`;
  return `${date}, ${time} IST`;
}

