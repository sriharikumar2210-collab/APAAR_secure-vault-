# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=3000

# PostgreSQL (or use the SQL_* variables instead)
DATABASE_URL=postgres://user:password@localhost:5432/apaar

# REQUIRED in production (each at least 32 random characters).
# Generate:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=
CREDENTIAL_SIGNING_SECRET=

# Demo accounts. Empty = random password printed in the dev console; locked in production.
DEMO_PASSWORD=
# One-click demo sign-in buttons. Development only, off unless "true".
ENABLE_DEMO_LOGIN=false

# Set to 1 when running behind one reverse proxy (Cloud Run, nginx...) so rate limits see real client IPs.
TRUST_PROXY=

# OTP delivery. Required in production for APAAR ID + OTP sign-in.
SMS_GATEWAY_URL=
SMS_GATEWAY_API_KEY=

# Optional: Gemini OCR
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
